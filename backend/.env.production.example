APP_NAME="Minion Barbershop"
APP_ENV=production
APP_KEY=                          # generate: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://app.minionbarbershop.com
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=minion_barbershop
DB_USERNAME=minion
DB_PASSWORD=                      # ganti dengan password kuat

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                   # ganti dengan password kuat

BROADCAST_CONNECTION=log

FILESYSTEM_DISK=public

SANCTUM_STATEFUL_DOMAINS=minionbarbershop.com,www.minionbarbershop.com

FILAMENT_ADMIN_PATH=admin-panel
FILAMENT_KASIR_PATH=kasir-panel
